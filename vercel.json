  "functions": {
    "api/admin/sns-hub/send-probe.js": {
      "regions": ["syd1"],
      "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,scripts/lib/fonts/**}"
    },
    "api/cron/sns-send.js": {
      "regions": ["syd1"],
      "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,scripts/lib/fonts/**}"
    },
    "api/cron/sns-auto-plan.js": {
      "regions": ["syd1"],
      "memory": 3009,
      "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,scripts/lib/fonts/**,sns-video-studio/remotion/risk-rules.json,src/locales/ja/common.json,config/today-variants.json}"
    },
    "api/cron/*.js": {
      "regions": ["syd1"]
    },
    "api/odds/live.js": {
      "regions": ["syd1"]
    },
    "api/bot-page/**/*.js": {
      "regions": ["syd1"],
      "includeFiles": "{src/locales/ja/common.json,src/locales/en/common.json,src/locales/zh-TW/common.json,src/locales/ko/common.json,index.html,src/data/blog-posts/**/*.json}"
    }
  },
  "redirects": [
    {
      "source": "/outcome-distribution",
      "destination": "/winning-technique?tab=outcome",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!api|assets|(?:(?:en|zh-TW|ko)/)?venue/(?:[1-9]|1\\d|2[0-4])$|(?:en|zh-TW|ko)/?$|today$|(?:(?:en|zh-TW|ko)/)?race/\\d{4}-\\d{2}-\\d{2}-\\d{2}-\\d{2}$).+)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/",
      "missing": [
        { "type": "header", "key": "user-agent", "value": ".*(?:GPTBot|ClaudeBot|PerplexityBot|Google-Extended|facebookexternalhit|Twitterbot|OAI-SearchBot|ChatGPT-User|Claude-SearchBot|Claude-User|Perplexity-User|bingbot|Applebot|DuckDuckBot).*" }
      ],
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/venue/((?:[1-9]|1\\d|2[0-4]))",
      "missing": [
        { "type": "header", "key": "user-agent", "value": ".*(?:GPTBot|ClaudeBot|PerplexityBot|Google-Extended|facebookexternalhit|Twitterbot|OAI-SearchBot|ChatGPT-User|Claude-SearchBot|Claude-User|Perplexity-User|bingbot|Applebot|DuckDuckBot).*" }
      ],
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/((?:en|zh-TW|ko)/?)",
      "missing": [
        { "type": "header", "key": "user-agent", "value": ".*(?:GPTBot|ClaudeBot|PerplexityBot|Google-Extended|facebookexternalhit|Twitterbot|OAI-SearchBot|ChatGPT-User|Claude-SearchBot|Claude-User|Perplexity-User|bingbot|Applebot|DuckDuckBot).*" }
      ],
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/((?:en|zh-TW|ko)/venue/(?:[1-9]|1\\d|2[0-4]))",
      "missing": [
        { "type": "header", "key": "user-agent", "value": ".*(?:GPTBot|ClaudeBot|PerplexityBot|Google-Extended|facebookexternalhit|Twitterbot|OAI-SearchBot|ChatGPT-User|Claude-SearchBot|Claude-User|Perplexity-User|bingbot|Applebot|DuckDuckBot).*" }
      ],
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/today",
      "missing": [
        { "type": "header", "key": "user-agent", "value": ".*(?:GPTBot|ClaudeBot|PerplexityBot|Google-Extended|facebookexternalhit|Twitterbot|OAI-SearchBot|ChatGPT-User|Claude-SearchBot|Claude-User|Perplexity-User|bingbot|Applebot|DuckDuckBot).*" }
      ],
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/((?:(?:en|zh-TW|ko)/)?race/\\d{4}-\\d{2}-\\d{2}-\\d{2}-\\d{2})",
      "missing": [
        { "type": "header", "key": "user-agent", "value": ".*(?:GPTBot|ClaudeBot|PerplexityBot|Google-Extended|facebookexternalhit|Twitterbot|OAI-SearchBot|ChatGPT-User|Claude-SearchBot|Claude-User|Perplexity-User|bingbot|Applebot|DuckDuckBot).*" }
      ],
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
