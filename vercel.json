{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/race-notices",
      "schedule": "*/10 22-23,0-14 * * *"
    },
    {
      "path": "/api/cron/race-status",
      "schedule": "*/10 21-23,0-14 * * *"
    },
    {
      "path": "/api/cron/scrape-monitor",
      "schedule": "*/5 22-23,0-14 * * *"
    },
    {
      "path": "/api/cron/scrape-summary",
      "schedule": "10 15 * * *"
    },
    {
      "path": "/api/cron/scrape-cleanup",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/result",
      "schedule": "* 22-23,0-15 * * *"
    },
    {
      "path": "/api/cron/kfile-sync",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/kfile-sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/result-catchup",
      "schedule": "50 14 * * *"
    },
    {
      "path": "/api/cron/result-catchup",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/point-rank",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/point-rank",
      "schedule": "30 14,16 * * *"
    },
    {
      "path": "/api/cron/entry-course-stats",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/entry-course-stats",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/entry-course-stats",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/venue-motor-stats",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/venue-motor-stats",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/racer-news",
      "schedule": "10 14 * * *"
    },
    {
      "path": "/api/cron/racer-news",
      "schedule": "10 16 * * *"
    },
    {
      "path": "/api/cron/racer-profiles",
      "schedule": "*/10 18-20 1 * *"
    },
    {
      "path": "/api/cron/racer-profiles",
      "schedule": "*/10 18-20 8,15 5,11 *"
    },
    {
      "path": "/api/cron/odds",
      "schedule": "* 22-23,0-14 * * *"
    },
    {
      "path": "/api/cron/race-info",
      "schedule": "* 22-23,0-14 * * *"
    },
    {
      "path": "/api/cron/exhibition",
      "schedule": "* 22-23,0-14 * * *"
    },
    {
      "path": "/api/cron/pit-reports",
      "schedule": "* 22-23,0-15 * * *"
    },
    {
      "path": "/api/cron/races-init",
      "schedule": "*/2 20-23,0-14 * * *"
    },
    {
      "path": "/api/cron/pcexpect",
      "schedule": "*/5 20-23,0-14 * * *"
    },
    {
      "path": "/api/cron/boatcast-oriten",
      "schedule": "* 22-23,0-14 * * *"
    },
    {
      "path": "/api/cron/boatcast-motor-start",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/boatcast-motor-start",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/motor-pretest",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/motor-pretest",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/motor-pretest",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/daily-reconcile",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/daily-reconcile",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/daily-reconcile",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/data-health",
      "schedule": "35 21-23 * * *"
    },
    {
      "path": "/api/cron/racer-course-technique-stats",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/racer-course-technique-stats",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/morning-digest",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/morning-digest",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/morning-digest",
      "schedule": "0 23 * * *"
    }
  ],
  "functions": {
    "api/cron/*.js": {
      "regions": [
        "syd1"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!api|assets).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, s-maxage=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
