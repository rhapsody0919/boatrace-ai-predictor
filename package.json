{
  "name": "boat-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npx playwright install chromium && node scripts/generate-ai-snapshots.js",
    "lint": "eslint .",
    "check:contrast": "node scripts/maintenance/check-token-contrast.js",
    "check:css-collisions": "node scripts/maintenance/check-css-class-collisions.js",
    "verify:sitemap": "node scripts/maintenance/verify-sitemap-coverage.js",
    "verify:adr-numbers": "node scripts/maintenance/verify-adr-numbers.js",
    "verify:migration-numbers": "node scripts/maintenance/verify-migration-numbers.js --base=origin/master",
    "verify:content-index": "node scripts/maintenance/verify-content-index-coverage.js",
    "check:session-start": "node scripts/maintenance/session-start-check.js",
    "check:deprecated-terms": "node scripts/maintenance/check-deprecated-terms.js",
    "verify:routine-routing": "node scripts/maintenance/verify-routine-routing.js",
    "verify:topic-target-claim": "node scripts/maintenance/verify-topic-target-claim.js",
    "verify:format-column-migration": "node scripts/maintenance/verify-format-column-migration.js",
    "verify:venue-motor-stats": "node scripts/maintenance/verify-venue-motor-stats-parsers.js",
    "verify:venue-motor-stats-drift": "node scripts/maintenance/verify-venue-motor-stats-drift-detection.js",
    "verify:race-stage": "node scripts/maintenance/verify-race-stage-parsing.js",
    "verify:race-notices": "node scripts/maintenance/verify-race-notices-parser.js",
    "verify:venue-entry-course-stats": "node scripts/maintenance/verify-venue-entry-course-stats-parser.js",
    "verify:er-diagram": "node scripts/maintenance/verify-plan-erd.js",
    "verify:actual-course-kfile": "node scripts/maintenance/verify-actual-course-kfile-parser.js",
    "verify:course-entry-tendency": "node scripts/maintenance/verify-course-entry-tendency.js",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "linear": "node scripts/linear-cli.js",
    "linear:create": "node scripts/linear-cli.js create",
    "linear:update": "node scripts/linear-cli.js update",
    "linear:comment": "node scripts/linear-cli.js comment",
    "linear:list": "node scripts/linear-cli.js list",
    "linear:get": "node scripts/linear-cli.js get"
  },
  "dependencies": {
    "@kirinsaninc/lhats": "^0.1.0",
    "@sendgrid/mail": "^8.1.6",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/supabase-js": "^2.89.0",
    "@vercel/functions": "^3.9.5",
    "cheerio": "^1.1.2",
    "framer-motion": "^12.35.0",
    "googleapis": "^168.0.0",
    "gray-matter": "^4.0.3",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "pdf2json": "^4.0.3",
    "playwright": "^1.59.1",
    "playwright-core": "^1.59.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "react-is": "^19.2.3",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0",
    "react-share": "^5.2.2",
    "recharts": "^3.6.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "twitter-api-v2": "^1.29.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  }
}
