{
  "$comment": "全貌動画の材料 JSON の契約（龍神の取得 fetch-materials.mjs → 毎日の実行 run-full.mjs）。形を変えたら schemaVersion を上げ、この Schema・fetch-materials.mjs の MATERIALS_VERSION・場面の build を同じ PR で直す（verify-full-picture-scene2.js が落とす）。build が読む所だけを required にする。",
  "$id": "full-picture-materials/1",
  "type": "object",
  "required": ["schemaVersion", "raceId", "date", "venueCode", "stage", "api", "db", "missing"],
  "properties": {
    "schemaVersion": { "const": "full-picture-materials/1" },
    "raceId": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{2}-\\d{2}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "venueCode": { "type": "integer", "minimum": 1, "maximum": 24 },
    "stage": { "enum": ["racecard", "exhibition"] },
    "race": {
      "$comment": "締切（races.start_time）とグレード（races.race_grade）。見出しに使うだけで、無ければ締切・グレードを書かない（BOA-989）",
      "type": ["object", "null"],
      "properties": { "startTime": { "type": ["string", "null"] }, "grade": { "type": ["string", "null"] } }
    },
    "api": {
      "type": "object",
      "required": ["facts", "similar", "scenario", "races", "outcome"],
      "properties": {
        "facts": {
          "type": ["object", "null"],
          "required": ["today", "facts"],
          "properties": {
            "today": { "type": "object", "required": ["scope_keys"], "properties": { "scope_keys": { "type": "object" } } },
            "facts": { "type": "object" }
          }
        },
        "similar": {
          "type": ["object", "null"],
          "required": ["similar"],
          "properties": {
            "similar": {
              "type": ["object", "null"],
              "required": ["neighbors"],
              "properties": {
                "neighbors": { "type": "array", "items": { "type": "object", "required": ["race_id", "finish"], "properties": { "race_id": { "type": "string" }, "finish": { "type": ["array", "null"] } } } }
              }
            }
          }
        },
        "scenario": { "$ref": "#/definitions/scenario" },
        "scenarioNC": { "$ref": "#/definitions/scenario" },
        "scenarioNCR": { "$ref": "#/definitions/scenario" },
        "scenarioNA": { "$ref": "#/definitions/scenario" },
        "scenarioVA": { "$ref": "#/definitions/scenario" },
        "races": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["raceId", "raceNumber", "entries"],
            "properties": {
              "raceId": { "type": "string" },
              "raceNumber": { "type": "integer" },
              "entries": { "type": ["array", "null"] },
              "weather": { "type": ["object", "null"] },
              "exhibitionData": { "type": ["array", "null"] },
              "result": { "type": ["object", "null"] }
            }
          }
        },
        "outcome": {
          "type": "object",
          "additionalProperties": {
            "type": ["object", "null"],
            "required": ["total_races", "data"],
            "properties": { "total_races": { "type": "integer" }, "data": { "type": "object" } }
          }
        }
      }
    },
    "db": {
      "type": "object",
      "required": ["racer1", "motor"],
      "properties": {
        "racer1": {
          "type": ["object", "null"],
          "required": ["entries", "races", "results", "st"],
          "properties": { "entries": { "type": "array" }, "races": { "type": "array" }, "results": { "type": "array" }, "st": { "type": "array" } }
        },
        "motor": {
          "type": ["object", "null"],
          "required": ["meetStart", "pretest", "stats", "meetEntries", "exhibition"],
          "properties": { "pretest": { "type": "array" }, "stats": { "type": "array" }, "meetEntries": { "type": "array" }, "exhibition": { "type": "array" } }
        },
        "exhibition": {
          "$comment": "展示の後の材料（stage=exhibition のときだけ。展示の前の材料には無い）。足しただけで build はまだ読まないので required にしない（版は上げない）。欠けた欄は null で、missing に db.exhibition.* で記録する。start_flag・parts_changed・propeller_change の null は「表示なし」で欠けではない",
          "type": ["object", "null"],
          "required": ["boats", "conditions", "technique"],
          "properties": {
            "boats": {
              "type": ["array", "null"],
              "items": {
                "type": "object",
                "required": ["boat_number", "exhibition_course", "start_timing", "start_flag", "exhibition_time", "tilt", "parts_changed", "propeller_change", "is_absent", "updated_at", "f_count", "meet_finishes"],
                "properties": {
                  "boat_number": { "type": "integer", "minimum": 1, "maximum": 6 },
                  "exhibition_course": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
                  "start_timing": { "type": ["number", "null"] },
                  "start_flag": { "type": ["string", "null"] },
                  "exhibition_time": { "type": ["number", "null"] },
                  "tilt": { "type": ["number", "null"] },
                  "parts_changed": { "type": ["array", "null"], "items": { "type": "string" } },
                  "propeller_change": { "type": ["string", "null"] },
                  "is_absent": { "type": ["boolean", "null"] },
                  "updated_at": { "type": ["string", "null"] },
                  "f_count": { "type": ["integer", "null"], "minimum": 0 },
                  "today_weight": { "$comment": "exhibition_data.today_weight（展示の体重 kg）。任意の欄", "type": ["number", "null"] },
                  "racer_id": { "type": ["integer", "null"] },
                  "course": { "$comment": "進入コース。exhibition_course があればそれ、無ければ枠番（course_source に書く）。任意の欄", "type": "integer", "minimum": 1, "maximum": 6 },
                  "course_source": { "enum": ["exhibition_course", "boat_number"] },
                  "course_technique": {
                    "$comment": "racer_course_technique_stats（racer_id, course）の行。最新の集計だけで、レースの日より後の集計なら missing に記録する。任意の欄",
                    "type": ["object", "null"],
                    "required": ["window_start", "window_end", "runs", "makuri_count", "makuri_rate", "runs_90d", "last_updated"],
                    "properties": {
                      "window_start": { "type": "string" },
                      "window_end": { "type": "string" },
                      "window_days": { "type": ["integer", "null"] },
                      "runs": { "type": "integer", "minimum": 0 },
                      "nige_count": { "type": ["integer", "null"] },
                      "nige_rate": { "type": ["number", "null"] },
                      "makuri_count": { "type": ["integer", "null"] },
                      "makuri_rate": { "type": ["number", "null"] },
                      "nigashi_count": { "type": ["integer", "null"] },
                      "nigashi_rate": { "type": ["number", "null"] },
                      "runs_90d": { "type": ["integer", "null"], "minimum": 0 },
                      "nige_rate_90d": { "type": ["number", "null"] },
                      "makuri_rate_90d": { "type": ["number", "null"] },
                      "nigashi_rate_90d": { "type": ["number", "null"] },
                      "last_updated": { "type": "string" }
                    }
                  },
                  "period_course": {
                    "$comment": "racer_period_stats の calc_to < レースの日 の最新の期の cN_*（N=course）。p1〜p3 は1〜3着の回数。任意の欄",
                    "type": ["object", "null"],
                    "required": ["period_year", "period_no", "calc_to", "course"],
                    "properties": {
                      "period_year": { "type": "integer" },
                      "period_no": { "type": "integer" },
                      "calc_to": { "type": "string" },
                      "course": { "type": "integer", "minimum": 1, "maximum": 6 },
                      "entries": { "type": ["integer", "null"] },
                      "avg_st": { "type": ["number", "null"] },
                      "avg_start_rank": { "type": ["number", "null"] },
                      "f": { "type": ["integer", "null"] },
                      "l0": { "type": ["integer", "null"] },
                      "l1": { "type": ["integer", "null"] },
                      "p1": { "type": ["integer", "null"] },
                      "p2": { "type": ["integer", "null"] },
                      "p3": { "type": ["integer", "null"] }
                    }
                  },
                  "attack_defense": {
                    "$comment": "画面の超展開データ（AttackDefenseTable、src/utils/attackDefenseCells.js）と同じ値。枠番（実進入コースでない）、予想（standard の最新）の時点。value は選手の値として使えるものだけ（全国平均から出た値は null、画面の文字は screen_value）。任意の欄",
                    "type": ["object", "null"],
                    "required": ["basis", "role", "wins", "total", "cells", "exhibition_course_differs"],
                    "properties": {
                      "basis": { "const": "boat_number" },
                      "role": { "enum": ["defense", "attack"] },
                      "wins": { "type": "integer", "minimum": 0 },
                      "total": { "type": "integer", "minimum": 0 },
                      "cells": {
                        "type": "object",
                        "required": ["nige", "sashi", "makuri", "makurizashi", "other"],
                        "additionalProperties": {
                          "type": "object",
                          "required": ["value", "state", "screen_value"],
                          "properties": {
                            "value": { "type": ["string", "null"] },
                            "state": { "enum": ["value", "reference", "national_default", "national_default_distribution", "no_distribution", "none"] },
                            "screen_value": { "type": ["string", "null"] }
                          }
                        }
                      },
                      "exhibition_course_differs": { "type": "boolean" },
                      "predicted_at": { "type": ["string", "null"] }
                    }
                  },
                  "st_consideration": {
                    "$comment": "画面の ST考察（computeStConsideration）と同じ値。このレースより前の730日の、実進入コースが course（枠番＝画面の枠なり想定）の走。late_rate は最速より0.10以上遅い率で公式の L ではない。任意の欄",
                    "type": ["object", "null"],
                    "required": ["course", "course_basis", "grade", "since", "n", "stable_rate", "late_rate", "breakout_count", "avg_st", "flying_count", "baseline"],
                    "properties": {
                      "course": { "type": "integer", "minimum": 1, "maximum": 6 },
                      "course_basis": { "const": "boat_number" },
                      "grade": { "type": ["string", "null"] },
                      "since": { "type": "string" },
                      "n": { "type": "integer", "minimum": 0 },
                      "small_sample": { "type": "boolean" },
                      "stable_rate": { "type": ["number", "null"] },
                      "late_rate": { "type": ["number", "null"] },
                      "breakout_count": { "type": ["integer", "null"] },
                      "avg_st": { "type": ["number", "null"] },
                      "flying_count": { "type": "integer", "minimum": 0 },
                      "baseline": { "type": ["object", "null"] }
                    }
                  },
                  "st_stability": {
                    "$comment": "画面に無い値。st_consideration と同じ走の、そのコースの直近30走（欠場を除く）の窓の F・L 以外の ST の母標準偏差（有効2走以上）と公式の L の回数。任意の欄",
                    "type": ["object", "null"],
                    "required": ["course", "window_runs", "valid_runs", "st_stddev", "official_l_count"],
                    "properties": {
                      "course": { "type": "integer", "minimum": 1, "maximum": 6 },
                      "window_runs": { "type": "integer", "minimum": 0, "maximum": 30 },
                      "valid_runs": { "type": "integer", "minimum": 0, "maximum": 30 },
                      "st_stddev": { "type": ["number", "null"], "minimum": 0 },
                      "official_l_count": { "type": "integer", "minimum": 0 },
                      "since": { "type": ["string", "null"] }
                    }
                  },
                  "condition_rows": {
                    "$comment": "基本情報タブの条件別の表（buildConditionRows）と同じ値。キーは national・local・ippan・sgg1・firstDay・finalDay・wave5・fHolding・fClean。行が null は race_conditions が読めず画面も出さない。率は%の1桁、avg_st は2桁。任意の欄",
                    "type": ["object", "null"],
                    "additionalProperties": { "$ref": "#/definitions/conditionRow" }
                  },
                  "condition_stats": {
                    "$comment": "選手ページのレース条件別の成績（aggregateRacerConditionStats）と同じ値。rows は5走以上の条件だけ（windStrong＝風5m以上、waveRough＝波5cm以上）。率は%の1桁。任意の欄",
                    "type": ["object", "null"],
                    "required": ["since", "overall", "rows"],
                    "properties": {
                      "since": { "type": ["string", "null"] },
                      "overall": { "$ref": "#/definitions/rateRow" },
                      "rows": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "object",
                          "required": ["group", "label", "n", "win_rate", "top2_rate", "top3_rate"],
                          "properties": {
                            "group": { "type": "string" },
                            "label": { "type": "string" },
                            "n": { "type": "integer", "minimum": 0 },
                            "win_rate": { "type": ["number", "null"] },
                            "top2_rate": { "type": ["number", "null"] },
                            "top3_rate": { "type": ["number", "null"] }
                          }
                        }
                      }
                    }
                  },
                  "meet_results": {
                    "$comment": "今節タブの日別の走りの表（buildMeetResults・getRecentRaces）と同じ行。決まり手は1着の走だけ。任意の欄",
                    "type": ["array", "null"],
                    "items": {
                      "type": "object",
                      "required": ["race_id", "date", "boat_number", "entry_course", "start_timing", "is_flying", "finish_rank", "finish_mark", "absent", "winning_technique", "race_stage"],
                      "properties": {
                        "race_id": { "type": "string" },
                        "date": { "type": "string" },
                        "race_no": { "type": ["integer", "null"] },
                        "boat_number": { "type": "integer", "minimum": 1, "maximum": 6 },
                        "entry_course": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
                        "start_timing": { "type": ["number", "null"] },
                        "is_flying": { "type": "boolean" },
                        "finish_rank": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
                        "finish_mark": { "type": ["string", "null"] },
                        "absent": { "type": "boolean" },
                        "winning_technique": { "type": ["string", "null"] },
                        "race_stage": { "type": ["string", "null"] },
                        "race_title": { "type": ["string", "null"] },
                        "exhibition_time": { "type": ["number", "null"] },
                        "exhibition_rank": { "type": ["integer", "null"] }
                      }
                    }
                  },
                  "entry_distribution": {
                    "$comment": "直前情報タブのこの枠からの進入コース（computeFrameEntryDistribution）。inward_rate が前づけ%。waku_nari は枠情報タブの枠なり進入率（computeWakuNariRate、全枠）。任意の欄",
                    "type": ["object", "null"],
                    "required": ["frame", "n", "counts", "waku_rate", "inward_rate", "outward_rate", "waku_nari"],
                    "properties": {
                      "frame": { "type": "integer", "minimum": 1, "maximum": 6 },
                      "n": { "type": "integer", "minimum": 0 },
                      "counts": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
                      "waku_rate": { "type": ["number", "null"] },
                      "inward_rate": { "type": ["number", "null"] },
                      "outward_rate": { "type": ["number", "null"] },
                      "waku_nari": {
                        "type": "object",
                        "required": ["rate", "n"],
                        "properties": { "rate": { "type": ["number", "null"] }, "n": { "type": "integer", "minimum": 0 } }
                      }
                    }
                  },
                  "accident": {
                    "$comment": "基本情報タブの今期の事故率（RPC get_racer_accident_records・computeAccidentStats）。rate は小数第2位で切り捨て。任意の欄",
                    "type": ["object", "null"],
                    "required": ["from", "to", "starts", "points", "rate", "need", "counts", "status", "settled", "show_badge"],
                    "properties": {
                      "from": { "type": "string" },
                      "to": { "type": "string" },
                      "starts": { "type": "integer", "minimum": 0 },
                      "points": { "type": "integer", "minimum": 0 },
                      "rate": { "type": ["number", "null"] },
                      "need": { "type": "integer", "minimum": 0 },
                      "counts": {
                        "type": "object",
                        "required": ["F", "L1", "K1", "S1", "S2"],
                        "additionalProperties": { "type": "integer", "minimum": 0 }
                      },
                      "status": { "enum": ["over", "near", null] },
                      "settled": { "type": "boolean" },
                      "show_badge": { "type": "boolean" }
                    }
                  },
                  "original_exhibition": {
                    "$comment": "オリジナル展示（getRaceOriginalExhibition と同じ表と整形）。キーは項目名（一周・半周ラップ・まわり足・直線と会場の項目）。行が無い（未公開）レースは null。任意の欄",
                    "type": ["object", "null"],
                    "additionalProperties": {
                      "type": "object",
                      "required": ["value", "status"],
                      "properties": {
                        "value": { "type": ["number", "null"] },
                        "status": { "enum": ["value", "no_value", "not_offered"] }
                      }
                    }
                  },
                  "entry_tendency": {
                    "$comment": "racer_aggregated_stats（venue_code=0＝全国）の course_entry_tendency.all のこの枠の {n, courses}（courses はコース→回数）と since。facts の racers.boats[].course_entry から写す。venue は会場の分（無ければ null）。任意の欄",
                    "type": ["object", "null"],
                    "required": ["boat_number", "n", "courses", "since"],
                    "properties": {
                      "boat_number": { "type": "integer", "minimum": 1, "maximum": 6 },
                      "n": { "type": ["integer", "null"] },
                      "courses": { "type": ["object", "null"] },
                      "venue": { "type": ["object", "null"] },
                      "since": { "type": ["string", "null"] },
                      "calculated_at": { "type": ["string", "null"] }
                    }
                  },
                  "meet_finishes": {
                    "type": ["array", "null"],
                    "items": {
                      "type": "object",
                      "required": ["race_id", "finish_mark", "finish_rank"],
                      "properties": { "race_id": { "type": "string" }, "finish_mark": { "type": ["string", "null"] }, "finish_rank": { "type": ["integer", "null"] } }
                    }
                  }
                }
              }
            },
            "conditions": {
              "type": ["object", "null"],
              "required": ["weather", "wind_direction", "wind_speed", "wave_height", "observedAt"],
              "properties": {
                "weather": { "type": ["string", "null"] },
                "wind_direction": { "type": ["string", "null"] },
                "wind_speed": { "type": ["number", "null"] },
                "wave_height": { "type": ["number", "null"] },
                "observedAt": { "type": ["string", "null"] }
              }
            },
            "technique": {
              "type": ["object", "null"],
              "required": ["byPeriod", "byBoat"],
              "properties": { "byPeriod": { "type": "array" }, "byBoat": { "type": "array" } }
            },
            "notes": { "$comment": "材料を読む側への注意（日付の無い表など）。任意の欄", "type": "array", "items": { "type": "string" } },
            "losingTechnique": {
              "$comment": "会場の負けの決まり手（losing_technique_stats、90日・会場×枠。LosingTechniqueChart と同じまとめ）。by_boat のキーは枠番。任意の欄",
              "type": ["object", "null"],
              "required": ["last_updated", "by_boat"],
              "properties": {
                "last_updated": { "type": ["string", "null"] },
                "by_boat": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": ["total_races", "techniques"],
                    "properties": {
                      "total_races": { "type": "integer", "minimum": 0 },
                      "techniques": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["technique", "count", "percentage"],
                          "properties": { "technique": { "type": "string" }, "count": { "type": "integer", "minimum": 0 }, "percentage": { "type": "number" } }
                        }
                      }
                    }
                  }
                }
              }
            },
            "originalExhibition": {
              "$comment": "オリジナル展示のレースの状態。state: published（値あり）・empty（値が1つも無い）・no_row（行が無い＝未公開・未取得）。measure_status 1=計測あり・2=計測不可。任意の欄",
              "type": ["object", "null"],
              "required": ["state", "measure_status", "item_labels", "kinds", "captured_at"],
              "properties": {
                "state": { "enum": ["published", "empty", "no_row"] },
                "measure_status": { "enum": [1, 2, null] },
                "item_labels": { "type": "array", "items": { "type": "string" } },
                "kinds": { "type": "array", "items": { "type": "string" } },
                "captured_at": { "type": ["string", "null"] },
                "last_written_at": { "type": ["string", "null"] }
              }
            },
            "venueCourse": {
              "$comment": "venue_course_technique_baseline の会場・レースのグレード（無ければ ippan）の6コース（courses）と、グレードを問わない ALL の6コース（all）。行の無いコースは null。任意の欄",
              "type": ["object", "null"],
              "required": ["race_grade", "courses", "all"],
              "properties": {
                "race_grade": { "type": "string" },
                "courses": { "type": "array", "items": { "$ref": "#/definitions/venueCourseRow" } },
                "all": { "type": "array", "items": { "$ref": "#/definitions/venueCourseRow" } }
              }
            }
          }
        }
      }
    },
    "missing": { "type": "array", "items": { "type": "object", "required": ["source", "reason"], "properties": { "source": { "type": "string" }, "reason": { "type": "string" } } } }
  },
  "definitions": {
    "rateRow": {
      "type": "object",
      "required": ["n", "win_rate", "top2_rate", "top3_rate"],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "win_rate": { "type": ["number", "null"] },
        "top2_rate": { "type": ["number", "null"] },
        "top3_rate": { "type": ["number", "null"] }
      }
    },
    "conditionRow": {
      "type": ["object", "null"],
      "required": ["n", "base_n", "win_rate", "top2_rate", "top3_rate", "avg_st", "avg_st_n"],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "base_n": { "type": ["integer", "null"], "minimum": 0 },
        "excluded_n": { "type": ["integer", "null"], "minimum": 0 },
        "win_rate": { "type": ["number", "null"] },
        "top2_rate": { "type": ["number", "null"] },
        "top3_rate": { "type": ["number", "null"] },
        "avg_st": { "type": ["number", "null"] },
        "avg_st_n": { "type": "integer", "minimum": 0 }
      }
    },
    "venueCourseRow": {
      "type": ["object", "null"],
      "required": ["course", "runs", "nige_rate", "makuri_rate", "nigashi_rate", "window_start", "window_end"],
      "properties": {
        "course": { "type": "integer", "minimum": 1, "maximum": 6 },
        "runs": { "type": "integer", "minimum": 0 },
        "nige_rate": { "type": ["number", "null"] },
