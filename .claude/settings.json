{
    "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
    },
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Read",
            "Edit",
            "Write",
            "Bash(node:*)",
            "Bash(npm run:*)",
            "Bash(git:*)",
            "Bash(ls:*)",
            "Bash(gh:*)",
            "Bash(vercel:*)",
            "Bash(curl:*)",
            "WebFetch(domain:www.boatrace.jp)",
            "WebFetch(domain:supabase.com)",
            "WebFetch(domain:github.com)",
            "WebSearch",
            "Skill(collect-stats)",
            "Skill(analyze-venue)",
            "Skill(daily-report)",
            "Skill(deploy-preview)"
        ],
        "deny": [
            "Bash(rm -rf:*)",
            "Bash(rm -r /:*)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-branch-check.sh\""
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.sh\"",
                        "statusMessage": "機密ファイルチェック"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "file=$(cat | jq -r '.tool_input.file_path' 2>/dev/null); if [[ \"$file\" == *.js ]] || [[ \"$file\" == *.jsx ]]; then npx prettier --write \"$file\" 2>/dev/null || true; fi"
                    }
                ]
            },
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-fix.sh\"",
                        "statusMessage": "eslint --fix",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}